{
  "manifest_version": 3,
  "name": "Image Downloader",
  "version": "1.0",
  "description": "Automatically detect and download high-resolution photos and images in batch or ZIP.",
  "permissions": [
    "downloads",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.dreamstime.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Download Images"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.dreamstime.com/*",
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
