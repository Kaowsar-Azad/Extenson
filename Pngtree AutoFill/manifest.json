{
  "manifest_version": 3,
  "name": "Pngtree Auto-Fill",
  "version": "1.1",
  "description": "Automatically fills Work details on Pngtree",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["*://upload.pngtree.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://upload.pngtree.com/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}
